# Copy this file to .env and fill in real values. Never commit .env.

# Random long string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=7941fc55da3f77a8a8d3cbf94acbd288e6d1fe3dccace0e77b7f905b501ee0b26a04672d15b6c2706727a35c9c943dbe

# bcrypt hash of your admin password. Generate one with:
# node utils/hashPassword.js "YourChosenPassword"
# Then paste the printed hash below (keep the quotes out).
ADMIN_PASSWORD_HASH=$2a$12$wZ.39g4Um8zgnney2tAaEOIkAhcQ1KJgjXLK7j61bOotfG4Jxze42

# Port the backend listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API in dev.
# e.g. http://localhost:5173,http://localhost:4000
CORS_ORIGIN=http://localhost:5173
